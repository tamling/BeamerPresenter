{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BeamerPresenter",
  "version": "4.5.0",
  "identifier": "app.beamerpresenter.linux",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "presenter",
        "title": "BeamerPresenter",
        "url": "index.html",
        "width": 1280,
        "height": 820,
        "minWidth": 680,
        "minHeight": 460,
        "backgroundColor": "#15171C"
      },
      {
        "label": "audience",
        "title": "Audience",
        "url": "audience.html",
        "width": 1024,
        "height": 640,
        "minWidth": 320,
        "minHeight": 200,
        "visible": false,
        "closable": false,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "category": "Education",
    "shortDescription": "Present LaTeX Beamer PDFs with speaker notes",
    "longDescription": "Presenter console for LaTeX Beamer and PDF decks: current and next slide, speaker notes (from split PDFs, \\note{} in the .tex, or PowerPoint files), clock and timer, overview grid, whiteboard, blackout — with a clean audience window on the projector.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": ["xdg-desktop-portal"],
        "recommends": [
          "xdg-desktop-portal-gtk",
          "libreoffice-impress",
          "latexmk",
          "texlive-latex-recommended"
        ]
      }
    }
  }
}
